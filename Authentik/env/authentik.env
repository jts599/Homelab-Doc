# Authentik Configuration
AUTHENTIK_SECRET_KEY=your_secret_key_here
AUTHENTIK_ERROR_REPORTING__ENABLED=false

# Bootstrap Admin User (only used during initial setup)
AUTHENTIK_BOOTSTRAP_PASSWORD=your_admin_password_here
AUTHENTIK_BOOTSTRAP_TOKEN=your_bootstrap_token_here
AUTHENTIK_BOOTSTRAP_EMAIL=admin@example.com

# Additional Authentik Settings
AUTHENTIK_LOG_LEVEL=info
AUTHENTIK_AVATARS=initials